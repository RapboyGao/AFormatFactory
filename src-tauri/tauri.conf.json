{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AFormatFactory",
  "version": "1.0.0",
  "identifier": "com.albert.aformatfactory.tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../vue"
  },
  "app": {
    "windows": [
      {
        "title": "AFormatFactory",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
